<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="RustVNC"
           Language="1033"
           Version="0.1.0"
           Manufacturer="RustVNC"
           UpgradeCode="1C72197C-B61E-463F-B7BF-3135721D4446">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of RustVNC is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="rustvnc.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/civl/RustVNC" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="RustVNC" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="RustVNC" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ClientComponent" Guid="77A5387B-1A06-44CF-908D-B49119D2D752">
        <File Id="ClientExe"
              Source="$(var.StageDir)\rustvnc-client.exe">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="RustVNC"
                    Description="RustVNC remote desktop"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes" />
          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="RustVNC"
                    Description="RustVNC remote desktop"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes" />
        </File>
        <RegistryValue Root="HKCU"
                       Key="Software\RustVNC"
                       Name="client"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
    </DirectoryRef>


    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuComponent" Guid="*">
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\RustVNC"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="RustVNC" Level="1">
      <ComponentRef Id="ClientComponent" />
      <ComponentRef Id="StartMenuComponent" />
    </Feature>
  </Product>
</Wix>
